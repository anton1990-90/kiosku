{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokoku-sales",
  "main": "sales_page/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "sales_page",
    // Binding ini WAJIB ada supaya Worker bisa membaca berkas statis lewat
    // env.ASSETS. Tanpa "binding", Cloudflare tetap menyajikan aset untuk
    // permintaan biasa, tetapi env.ASSETS di dalam Worker bernilai undefined —
    // jadi setiap kode yang memanggilnya diam-diam jatuh ke cabang cadangan.
    "binding": "ASSETS",
    // Tanpa ini, berkas statis dilayani SEBELUM Worker berjalan — jadi
    // penanganan /internal/* di sales_page/worker.js tidak pernah dieksekusi
    // dan header noindex-nya tidak pernah terpasang. Pola di bawah memaksa
    // Worker berjalan lebih dulu khusus untuk alamat internal.
    "run_worker_first": ["/internal", "/internal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokoku-lisensi",
      "database_id": "7b228966-1656-4c35-9ed8-f8e3e3f88377"
    }
  ]
}
